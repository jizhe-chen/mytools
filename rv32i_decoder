<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>RV32I 批量解码器 · 支持输入/COE文件 · 2000+行</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(150deg, #0b0d17 0%, #161b2a 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Fira Code', 'JetBrains Mono', 'Consolas', 'Courier New', monospace;
            padding: 20px;
            margin: 0;
        }
        .main-container {
            width: 100%;
            max-width: 1200px;
            background: rgba(14, 16, 26, 0.85);
            backdrop-filter: blur(28px);
            border-radius: 48px;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
            padding: 28px 28px 32px;
            color: #e0e5ff;
        }
        h2 {
            text-align: center;
            font-weight: 500;
            font-size: 1.8rem;
            letter-spacing: 2px;
            margin-bottom: 16px;
            color: #cdd6ff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        h2 span {
            background: #2e3548;
            padding: 4px 18px;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 500;
            color: #ffdb9c;
        }
        .mode-selector {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .mode-btn {
            background: rgba(40, 45, 70, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 40px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 0.95rem;
            color: #cdd6ff;
            cursor: pointer;
            transition: 0.2s;
            letter-spacing: 0.8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .mode-btn.active {
            background: #f0b35e;
            color: #1a1e2b;
            border-color: #ffcf8a;
            box-shadow: 0 0 20px #ff9f2e60;
        }
        .mode-btn:hover {
            background: #5f6990;
            border-color: rgba(255,255,255,0.5);
        }
        .mode-btn.active:hover {
            background: #ffc47a;
        }
        .input-section {
            margin-bottom: 18px;
        }
        .file-upload-area {
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            background: #11141f;
            border-radius: 30px;
            padding: 12px 20px;
            border: 1px solid rgba(255,255,255,0.15);
        }
        .file-label {
            background: #3f4560;
            border-radius: 30px;
            padding: 10px 24px;
            cursor: pointer;
            font-weight: 600;
            color: #f0f0ff;
            transition: 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .file-label:hover {
            background: #6a73a0;
        }
        input[type="file"] {
            display: none;
        }
        .file-name {
            color: #b9c6e0;
            font-size: 0.9rem;
            flex: 1;
        }
        .editor-layout {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .panel {
            flex: 1;
            min-width: 300px;
            background: #0f111c;
            border-radius: 32px;
            padding: 16px 16px 12px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: inset 0 6px 14px rgba(0,0,0,0.6);
            display: flex;
            flex-direction: column;
        }
        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #b9c2ff;
            border-bottom: 1px solid #2c314a;
            padding-bottom: 6px;
        }
        textarea {
            width: 100%;
            flex: 1;
            background: #0a0c16;
            border: 1px solid #3b405a;
            border-radius: 20px;
            padding: 14px;
            font-family: inherit;
            font-size: 0.9rem;
            color: #f0f4ff;
            line-height: 1.6;
            resize: vertical;
            outline: none;
            transition: 0.2s;
            letter-spacing: 0.6px;
            caret-color: #ffb347;
            min-height: 400px;
        }
        textarea:focus {
            border-color: #f0b35e;
            box-shadow: 0 0 18px #ff9f2e40;
        }
        .output-container {
            background: #0c0f1a;
            border: 1px solid #3b405a;
            border-radius: 20px;
            padding: 10px 12px;
            flex: 1;
            min-height: 400px;
            max-height: 600px;
            overflow-y: auto;
            overflow-x: auto;
            font-family: inherit;
            font-size: 0.85rem;
            color: #e0d7b0;
            white-space: pre;
            line-height: 1.65;
        }
        .output-line {
            display: flex;
            gap: 8px;
        }
        .line-num {
            color: #4f5680;
            min-width: 36px;
            text-align: right;
            user-select: none;
        }
        .hex-part {
            color: #b9c6e0;
            min-width: 80px;
        }
        .inst-part {
            color: #ffcf8a;
            font-weight: 500;
        }
        .error-part {
            color: #ff8a8a;
        }
        .button-row {
            display: flex;
            gap: 12px;
            margin-top: 18px;
            justify-content: center;
            flex-wrap: wrap;
        }
        button {
            background: rgba(63, 70, 100, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 40px;
            padding: 10px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #f2f4ff;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s;
            letter-spacing: 0.8px;
        }
        button:hover {
            background: #6a73a0;
            border-color: rgba(255,255,255,0.5);
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.5);
        }
        .hint {
            color: #878eb0;
            font-size: 0.8rem;
            margin-top: 12px;
            text-align: center;
        }
        @media (max-width: 750px) {
            .editor-layout {
                flex-direction: column;
            }
            .output-container {
                max-height: 450px;
            }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <h2>
            📜 RV32I 批量解码
            <span>Hex / COE → 指令</span>
        </h2>

        <!-- 模式选择 -->
        <div class="mode-selector">
            <div class="mode-btn active" id="modeTextBtn">
                <span>✍️</span> 文本输入
            </div>
            <div class="mode-btn" id="modeFileBtn">
                <span>📂</span> 上传COE文件
            </div>
        </div>

        <!-- 文件上传区域 (默认隐藏) -->
        <div class="input-section" id="fileUploadSection" style="display: none;">
            <div class="file-upload-area">
                <label for="coeFileInput" class="file-label">
                    <span>📁</span> 选择 .coe 文件
                </label>
                <input type="file" id="coeFileInput" accept=".coe,.txt,.hex">
                <span class="file-name" id="fileNameDisplay">未选择文件</span>
            </div>
        </div>

        <!-- 左右对照编辑区 -->
        <div class="editor-layout">
            <div class="panel">
                <div class="panel-header">
                    <span>🔢 十六进制源</span>
                    <span style="font-size:0.7rem; color:#7f87ae;" id="lineCountLabel">0 行</span>
                </div>
                <textarea id="hexTextarea" placeholder="每行一个8位十六进制数, 例如:
00A50533
00008067
00410113
...">00A50533
00008067
00410113
00C000EF
FE010113
00100073
</textarea>
            </div>
            <div class="panel">
                <div class="panel-header">
                    <span>⚙️ RV32I 指令</span>
                    <span style="font-size:0.7rem; color:#7f87ae;" id="outputCountLabel">0 条</span>
                </div>
                <div class="output-container" id="outputContainer">
                    <!-- 动态渲染指令 -->
                </div>
            </div>
        </div>

        <div class="button-row">
            <button id="decodeBtn"><span>🔍</span> 解码</button>
            <button id="clearBtn"><span>🧹</span> 清空</button>
            <button id="exportBtn"><span>⬇️</span> 导出TXT</button>
        </div>
        <div class="hint">
            ⚡ 文本模式：每行8位十六进制 · COE模式：自动跳过前两行，解析逗号分隔的十六进制 · 支持2000+行
        </div>
    </div>

    <script>
        // 喵呜 (代码开始注释)
        (function() {
            // --- DOM 元素 ---
            const modeTextBtn = document.getElementById('modeTextBtn');
            const modeFileBtn = document.getElementById('modeFileBtn');
            const fileUploadSection = document.getElementById('fileUploadSection');
            const coeFileInput = document.getElementById('coeFileInput');
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            const hexTextarea = document.getElementById('hexTextarea');
            const outputContainer = document.getElementById('outputContainer');
            const decodeBtn = document.getElementById('decodeBtn');
            const clearBtn = document.getElementById('clearBtn');
            const exportBtn = document.getElementById('exportBtn');
            const lineCountLabel = document.getElementById('lineCountLabel');
            const outputCountLabel = document.getElementById('outputCountLabel');

            // 当前模式: 'text' 或 'file'
            let currentMode = 'text';
            // 存储解析后的指令结果 (用于导出)
            let currentInstructions = [];

            // --- 寄存器名称 ---
            function regName(index) {
                const abi = [
                    'zero', 'ra', 'sp', 'gp', 'tp', 't0', 't1', 't2',
                    's0/fp', 's1', 'a0', 'a1', 'a2', 'a3', 'a4', 'a5',
                    'a6', 'a7', 's2', 's3', 's4', 's5', 's6', 's7',
                    's8', 's9', 's10', 's11', 't3', 't4', 't5', 't6'
                ];
                return `x${index}(${abi[index] || ''})`;
            }

            // --- 十六进制转32位二进制 ---
            function hexToBinary32(hexStr) {
                hexStr = hexStr.replace(/\s/g, '').toUpperCase();
                if (!/^[0-9A-F]{8}$/.test(hexStr)) {
                    throw new Error('无效十六进制 (需8位)');
                }
                let binary = '';
                for (let i = 0; i < 8; i++) {
                    let chunk = parseInt(hexStr[i], 16).toString(2);
                    while (chunk.length < 4) chunk = '0' + chunk;
                    binary += chunk;
                }
                return binary;
            }

            // --- RV32I 解码核心 ---
            function decodeInstruction(binary32) {
                const opcode = binary32.substring(25, 32);
                const rd = binary32.substring(20, 25);
                const funct3 = binary32.substring(17, 20);
                const rs1 = binary32.substring(12, 17);
                const rs2 = binary32.substring(7, 12);
                const funct7 = binary32.substring(0, 7);
                const rdNum = parseInt(rd, 2);
                const rs1Num = parseInt(rs1, 2);
                const rs2Num = parseInt(rs2, 2);
                let text = '';

                if (opcode === '0110011') {
                    const f7 = funct7, f3 = funct3;
                    let mnem = '';
                    if (f3 === '000') mnem = (f7 === '0100000') ? 'SUB' : 'ADD';
                    else if (f3 === '001') mnem = 'SLL';
                    else if (f3 === '010') mnem = 'SLT';
                    else if (f3 === '011') mnem = 'SLTU';
                    else if (f3 === '100') mnem = 'XOR';
                    else if (f3 === '101') mnem = (f7 === '0100000') ? 'SRA' : 'SRL';
                    else if (f3 === '110') mnem = 'OR';
                    else if (f3 === '111') mnem = 'AND';
                    else mnem = '?R?';
                    text = `${mnem} ${regName(rdNum)}, ${regName(rs1Num)}, ${regName(rs2Num)}`;
                } else if (opcode === '0010011') {
                    const immBits = binary32.substring(0, 12);
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 4096;
                    const f3 = funct3;
                    let mnem = '';
                    if (f3 === '000') mnem = 'ADDI';
                    else if (f3 === '001') mnem = 'SLLI';
                    else if (f3 === '010') mnem = 'SLTI';
                    else if (f3 === '011') mnem = 'SLTIU';
                    else if (f3 === '100') mnem = 'XORI';
                    else if (f3 === '101') mnem = (funct7.substring(0,6)==='010000')?'SRAI':'SRLI';
                    else if (f3 === '110') mnem = 'ORI';
                    else if (f3 === '111') mnem = 'ANDI';
                    else mnem = '?I?';
                    text = `${mnem} ${regName(rdNum)}, ${regName(rs1Num)}, ${immVal}`;
                } else if (opcode === '0000011') {
                    const immBits = binary32.substring(0, 12);
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 4096;
                    const loadMap = {'000':'LB','001':'LH','010':'LW','100':'LBU','101':'LHU'};
                    const mnem = loadMap[funct3] || '?LOAD?';
                    text = `${mnem} ${regName(rdNum)}, ${immVal}(${regName(rs1Num)})`;
                } else if (opcode === '0100011') {
                    const imm4_0 = binary32.substring(20, 25);
                    const imm11_5 = binary32.substring(0, 7);
                    const immBits = imm11_5 + imm4_0;
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 4096;
                    const storeMap = {'000':'SB','001':'SH','010':'SW'};
                    const mnem = storeMap[funct3] || '?STORE?';
                    text = `${mnem} ${regName(rs2Num)}, ${immVal}(${regName(rs1Num)})`;
                } else if (opcode === '1100011') {
                    const imm12 = binary32[0], imm10_5 = binary32.substring(1,7);
                    const imm4_1 = binary32.substring(20,24), imm11 = binary32[7];
                    const immBits = imm12 + imm11 + imm10_5 + imm4_1 + '0';
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 8192;
                    const branchMap = {'000':'BEQ','001':'BNE','100':'BLT','101':'BGE','110':'BLTU','111':'BGEU'};
                    const mnem = branchMap[funct3] || '?BR?';
                    text = `${mnem} ${regName(rs1Num)}, ${regName(rs2Num)}, ${immVal}`;
                } else if (opcode === '1101111') {
                    const imm20 = binary32[0], imm10_1 = binary32.substring(1,11);
                    const imm11 = binary32[11], imm19_12 = binary32.substring(12,20);
                    const immBits = imm20 + imm19_12 + imm11 + imm10_1 + '0';
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 2097152;
                    text = `JAL ${regName(rdNum)}, ${immVal}`;
                } else if (opcode === '1100111') {
                    const immBits = binary32.substring(0, 12);
                    let immVal = parseInt(immBits, 2);
                    if (immBits[0] === '1') immVal -= 4096;
                    text = `JALR ${regName(rdNum)}, ${immVal}(${regName(rs1Num)})`;
                } else if (opcode === '0110111') {
                    const immBits = binary32.substring(0, 20);
                    let immVal = parseInt(immBits, 2) << 12;
                    text = `LUI ${regName(rdNum)}, 0x${(immVal >>> 12).toString(16).toUpperCase()}`;
                } else if (opcode === '0010111') {
                    const immBits = binary32.substring(0, 20);
                    let immVal = parseInt(immBits, 2) << 12;
                    text = `AUIPC ${regName(rdNum)}, 0x${(immVal >>> 12).toString(16).toUpperCase()}`;
                } else if (opcode === '1110011') {
                    const immBits = binary32.substring(0,12);
                    let immVal = parseInt(immBits,2);
                    if (immBits[0]==='1') immVal -= 4096;
                    if (funct3 === '000') {
                        if (immVal === 0) text = 'ECALL';
                        else if (immVal === 1) text = 'EBREAK';
                        else text = '系统指令';
                    } else text = 'CSR指令';
                } else if (opcode === '0001111') {
                    text = 'FENCE / FENCE.I';
                } else {
                    text = `未知指令(opcode:${opcode})`;
                }
                return text;
            }

            // --- 解析一行十六进制 ---
            function parseHexLine(line) {
                const trimmed = line.trim();
                if (trimmed === '') return null;
                let clean = trimmed.replace(/^0x/i, '').replace(/\s/g, '').toUpperCase();
                if (clean.length !== 8 || !/^[0-9A-F]{8}$/.test(clean)) {
                    return { hex: trimmed, instruction: '', error: '无效十六进制' };
                }
                try {
                    const bin = hexToBinary32(clean);
                    const inst = decodeInstruction(bin);
                    return { hex: clean, instruction: inst, error: null };
                } catch (e) {
                    return { hex: clean, instruction: '', error: e.message };
                }
            }

            // --- 从文本区域获取十六进制列表 ---
            function getHexLinesFromTextarea() {
                return hexTextarea.value.split('\n');
            }

            // --- 渲染输出 (使用虚拟滚动思路？直接操作DOM，但2000行以内性能足够) ---
            function renderOutput(instructions) {
                currentInstructions = instructions;
                // 使用 DocumentFragment 批量插入，提升性能
                const fragment = document.createDocumentFragment();
                const container = outputContainer;
                // 清空容器
                container.innerHTML = '';

                if (instructions.length === 0) {
                    container.innerHTML = '<div style="color:#5f6690; padding:10px;">等待解码...</div>';
                    outputCountLabel.textContent = '0 条';
                    return;
                }

                for (let i = 0; i < instructions.length; i++) {
                    const item = instructions[i];
                    const lineDiv = document.createElement('div');
                    lineDiv.className = 'output-line';
                    
                    const numSpan = document.createElement('span');
                    numSpan.className = 'line-num';
                    numSpan.textContent = i + 1;
                    
                    const hexSpan = document.createElement('span');
                    hexSpan.className = 'hex-part';
                    hexSpan.textContent = item.hex || '';
                    
                    const instSpan = document.createElement('span');
                    if (item.error) {
                        instSpan.className = 'error-part';
                        instSpan.textContent = `⚠️ ${item.error}`;
                    } else {
                        instSpan.className = 'inst-part';
                        instSpan.textContent = item.instruction;
                    }
                    
                    lineDiv.appendChild(numSpan);
                    lineDiv.appendChild(hexSpan);
                    lineDiv.appendChild(instSpan);
                    fragment.appendChild(lineDiv);
                }
                
                container.appendChild(fragment);
                outputCountLabel.textContent = `${instructions.length} 条`;
            }

            // --- 处理文本模式解码 ---
            function decodeFromText() {
                const lines = getHexLinesFromTextarea();
                const results = [];
                for (let line of lines) {
                    const res = parseHexLine(line);
                    if (res) results.push(res);
                }
                lineCountLabel.textContent = `${lines.length} 行`;
                renderOutput(results);
            }

            // --- 处理COE文件内容 ---
            function parseCoeContent(content) {
                const lines = content.split(/\r?\n/);
                const hexList = [];
                // 跳过前两行 (通常是注释/头部)
                for (let i = 2; i < lines.length; i++) {
                    const line = lines[i].trim();
                    if (line === '') continue;
                    // 按逗号分割
                    const parts = line.split(',');
                    for (let part of parts) {
                        const trimmed = part.trim();
                        if (trimmed !== '') {
                            hexList.push(trimmed);
                        }
                    }
                }
                return hexList;
            }

            function decodeFromCoeFile(file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const content = e.target.result;
                    const hexList = parseCoeContent(content);
                    // 将十六进制列表填入文本区域(可选，但为了展示，可以填入)
                    hexTextarea.value = hexList.join('\n');
                    lineCountLabel.textContent = `${hexList.length} 行`;
                    // 解码
                    const results = [];
                    for (let h of hexList) {
                        const res = parseHexLine(h);
                        if (res) results.push(res);
                    }
                    renderOutput(results);
                };
                reader.readAsText(file);
            }

            // --- 模式切换 ---
            function setMode(mode) {
                currentMode = mode;
                if (mode === 'text') {
                    modeTextBtn.classList.add('active');
                    modeFileBtn.classList.remove('active');
                    fileUploadSection.style.display = 'none';
                    hexTextarea.style.display = 'block';
                    // 保持文本区域内容不变，重新解码
                    decodeFromText();
                } else {
                    modeFileBtn.classList.add('active');
                    modeTextBtn.classList.remove('active');
                    fileUploadSection.style.display = 'block';
                    // 不清空文本区域，但用户需上传文件
                }
            }

            // --- 导出为TXT ---
            function exportToTxt() {
                if (currentInstructions.length === 0) {
                    alert('没有可导出的指令。');
                    return;
                }
                let txtContent = '';
                for (let i = 0; i < currentInstructions.length; i++) {
                    const item = currentInstructions[i];
                    const lineNum = i + 1;
                    if (item.error) {
                        txtContent += `${lineNum}\t${item.hex}\t[错误] ${item.error}\n`;
                    } else {
                        txtContent += `${lineNum}\t${item.hex}\t${item.instruction}\n`;
                    }
                }
                const blob = new Blob([txtContent], {type: 'text/plain'});
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `rv32i_decoded_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            // --- 事件绑定 ---
            modeTextBtn.addEventListener('click', () => setMode('text'));
            modeFileBtn.addEventListener('click', () => setMode('file'));

            coeFileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;
                fileNameDisplay.textContent = file.name;
                decodeFromCoeFile(file);
            });

            decodeBtn.addEventListener('click', () => {
                if (currentMode === 'text') {
                    decodeFromText();
                } else {
                    if (coeFileInput.files.length > 0) {
                        decodeFromCoeFile(coeFileInput.files[0]);
                    } else {
                        alert('请先上传COE文件。');
                    }
                }
            });

            clearBtn.addEventListener('click', () => {
                hexTextarea.value = '';
                outputContainer.innerHTML = '<div style="color:#5f6690; padding:10px;">等待解码...</div>';
                currentInstructions = [];
                lineCountLabel.textContent = '0 行';
                outputCountLabel.textContent = '0 条';
                coeFileInput.value = '';
                fileNameDisplay.textContent = '未选择文件';
            });

            exportBtn.addEventListener('click', exportToTxt);

            // 文本区域实时更新 (可选，为了流畅，使用input事件但防抖)
            let inputTimeout;
            hexTextarea.addEventListener('input', () => {
                if (currentMode !== 'text') return;
                clearTimeout(inputTimeout);
                inputTimeout = setTimeout(() => {
                    decodeFromText();
                }, 150);
            });

            // 初始化解码
            window.addEventListener('load', () => {
                decodeFromText();
            });

        })();
        // 喵呜 (代码结束注释)
    </script>
</body>
</html>
